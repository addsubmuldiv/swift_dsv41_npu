# D-class guardrails:
# - 参考值必须独立构造（fp64 CPU ref / 手算公式 / PyTorch native 对照），禁止循环论证
# - 禁止恒真断言：同对象自比较、同模块 round-trip 自证、无 RNG 重 seed 自证、
#   自己置位自己断言、stub（字面 pass）空测 —— 见 assertion-guide.md「恒真断言禁令」
# - 每文件：L1.2/L1.3 数值断言占比 ≥50%，反向/扰动断言 ≥1 条，smoke ≤2 条
# - 同构 case 重复 ≥3 次必须 parametrize 合并；禁止重复定义 utils.py 已有的 helper

import pytest
import torch
from utils import npu_available, assert_close, dtype_tols, to_cpu, make_reference_and_test_tensors

pytestmark = pytest.mark.skipif(not npu_available(), reason="NPU device is required")

# ── helpers ──────────────────────────────────────────────────────────────────

def _device():
    return torch.device("npu")

def _seed():
    torch.manual_seed(42)
    torch.npu.manual_seed(42)

def _randn(shape, dtype=torch.float32):
    """NPU 随机数 kernel 不可靠，CPU 生成再 .to(npu)"""
    return torch.randn(shape, dtype=dtype, device="cpu").to(device=_device())


